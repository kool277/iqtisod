{
  "name": "moliya",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "E2E_TARGET=preview playwright test",
    "fixtures:generate": "vitest run --config vitest.fixtures.config.ts",
    "decrypt": "node tools/moliya-decrypt.mjs",
    "rates:fetch": "node --experimental-strip-types tools/fetch-rates.ts"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@zip.js/zip.js": "^2.18.2",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unpdf": "^1.8.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
